# Copie para .env (que é ignorado pelo git) e ajuste.
#   Copy-Item .env.example .env

# Perfil da SUA conta pessoal de estudos (nunca a conta do trabalho).
# Criado com: aws configure --profile estudos   (ou aws configure sso)
AWS_PROFILE=estudos

# Região padrão dos labs (a maioria das demos do curso usa us-east-1)
AWS_DEFAULT_REGION=us-east-1
